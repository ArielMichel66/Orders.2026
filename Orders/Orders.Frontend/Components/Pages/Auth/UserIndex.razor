@page "/users"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Users"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between align-items-center">
                <MudText Typo="Typo.h6" Class="me-4">Usuarios</MudText>
                <MudButton Variant="Variant.Outlined"
                           EndIcon="@Icons.Material.Filled.PersonAdd"
                           Color="Color.Info"
                           Href="/register/?IsAdmin=true">
                    Adicionar Administrador
                </MudButton>
            </div>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Imagen</MudTh>
            <MudTh>Usuario</MudTh>
            <MudTh>Documento</MudTh>
            <MudTh>Teléfono</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Dirección</MudTh>
            <MudTh>Confirmado</MudTh>
            <MudTh>Tipo Usuario</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Imagen">
                @* <MudAvatar Image="@context.Photo" Size="Size.Medium" /> *@
                <MudAvatar Size="Size.Medium">
                    @if (!string.IsNullOrEmpty(context.Photo))
                    {
                        <MudImage Src="@context.Photo" Alt="Foto de usuario" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                    }
                </MudAvatar>
            </MudTd>
            <MudTd DataLabel="Usuario">@context.FullName</MudTd>
            <MudTd DataLabel="Documento">@context.Document</MudTd>
            <MudTd DataLabel="Teléfono">@context.PhoneNumber</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Dirección">
                @($"{context.Address}, {context.City?.Name}, {context.City?.State?.Name}, {context.City?.State?.Country?.Name}")
            </MudTd>
            <MudTd DataLabel="Confirmado">
                @if (context.EmailConfirmed)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Sí</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">No</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Tipo Usuario">@context.UserType.GetEnumDescription()</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay registros</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}
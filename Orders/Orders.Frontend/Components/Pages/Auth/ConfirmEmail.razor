@page "/api/accounts/ConfirmEmail"

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center min-vh-100">
    <MudPaper Elevation="4" Class="pa-8 text-center" Style="width: 100%; border-radius: 16px;">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            @* Icono de bienvenida *@
            <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Color="Color.Primary" Style="font-size: 5rem;" />

            <MudText Typo="Typo.h4" Color="Color.Primary">Confirmación de cuenta</MudText>

            <MudText Typo="Typo.body1">
                ¡Gracias por llegar hasta aquí! Para activar completamente tu acceso al sistema, por favor presiona el botón de abajo.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       OnClick="ConfirmAccountAsync"
                       StartIcon="@Icons.Material.Filled.VerifiedUser"
                       Class="mt-4 py-3">
                Confirmar mi Cuenta
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>
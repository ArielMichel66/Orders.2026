<AuthorizeView>
    <Authorized>
        <MudPaper Elevation="0" Class="pa-3" Style="min-width: 220px;">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudBadge Color="Color.Success"
                          Overlap="true"
                          Bordered="true"
                          Dot="true"
                          AnchorOrigin="Origin.BottomRight">
                    <MudAvatar Size="Size.Large">
                        @if (!string.IsNullOrEmpty(photoUser))
                        {
                            <MudImage Src="@photoUser" Alt="Foto de usuario" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        }
                    </MudAvatar>
                </MudBadge>

                <MudStack Spacing="0" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Hola,</MudText>
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@context.User.Identity!.Name</MudText>
                </MudStack>
            </MudStack>

            <MudDivider Class="my-2" />

            <MudList T="string" Clickable="true" Dense="true">
                <MudListItem OnClick="EditAction" Icon="@Icons.Material.Filled.Person" Text="Editar Perfil" />
                <MudListItem OnClick="ShowModalLogOut" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" Text="Cerrar Sesión" />
            </MudList>
        </MudPaper>
    </Authorized>

    <NotAuthorized>
        <MudMenuItem OnClick="ShowModalLogIn" Icon="@Icons.Material.Filled.Login">
            Iniciar Sesión
        </MudMenuItem>
        <MudMenuItem OnClick="ShowModalRegister" Icon="@Icons.Material.Filled.HowToReg">
            Registrar Usuario
        </MudMenuItem>
    </NotAuthorized>
</AuthorizeView>